-v $HOME/repos:/repos
-v $HOME/.ssh:/home/admin/.ssh
-v /etc/localtime:/etc/localtime:ro 
-v /etc/timezone:/etc/timezone:ro 
-v /tmp/.X11-unix:/tmp/.X11-unix
-v /dev:/dev
--device=/dev/gpiochip0:/dev/gpiochip0
--device=/dev/gpiochip1:/dev/gpiochip1
--device=/dev/i2c-0:/dev/i2c-0
--device=/dev/i2c-1:/dev/i2c-1
--device=/dev/i2c-7:/dev/i2c-7
--device=/dev/bus/usb:/dev/bus/usb
--gpus all
--privileged
--env ROS_LOCALHOST_ONLY=0
--env FASTRTPS_DEFAULT_PROFILES_FILE=/workspaces/isaac_ros-dev/src/RCCar/rc_hardware_control/config/disable_shm.xml
# Run evidence out of the container. run_dev.sh uses --rm, and /home/admin is
# not otherwise mounted, so everything under ~/.ros dies with the container:
# node and launch logs, the tracking recorder's goals_*.csv and samples_*.csv,
# and the soak recorder's soak_*.csv and events_*.csv. A field run that ends in
# a crash then leaves nothing to debug. ISAAC_ROS_WS is exported in the host
# ~/.bashrc; start_workspace.sh creates the directory so docker cannot create it
# as root, which would leave the container's admin user unable to write.
-v $ISAAC_ROS_WS/runs:/home/admin/.ros
